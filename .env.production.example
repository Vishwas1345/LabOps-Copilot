# Production environment. Copy to .env.production on the host, fill it in, and
# chmod 600. The real file is git-ignored; this one holds placeholders only.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production

# ---- Required, or compose refuses to start ------------------------------------

# The hostname the certificate is issued for. No default on purpose: a wrong or
# empty value produces a certificate no browser accepts.
#
# It does not have to be a purchased domain. An IP-based hostname from a free
# resolver works with this Caddyfile unchanged, because certificate issuance
# uses the normal HTTP-01 challenge on port 80 and needs only a hostname that
# resolves to this machine:
#
#   VPS public IP 203.0.113.5  ->  SITE_DOMAIN=203-0-113-5.nip.io
#                                (or 203-0-113-5.sslip.io)
#
# A permanent free subdomain, e.g. yourname.eu.org, also works but approval is
# manual and takes days to weeks. A purchased domain is the only option that
# needs no caveat, and costs about the price of a coffee a month.
#
# Caveat on the shared resolvers: thousands of sites use them, so a Let's
# Encrypt certificate can occasionally fail to issue. If it does, the other
# resolver will usually succeed, and a purchased domain never has the problem.
SITE_DOMAIN=example.com

# The database password. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# ---- Secrets, optional features -------------------------------------------------

# Base64 of exactly 32 bytes, for AES-256-GCM on integration credentials.
# Generate with: openssl rand -base64 32
# Without it, saving a credential fails by name instead of storing it in the clear.
CREDENTIALS_KEY=

# Google sign-in. All four or none; empty means the option is off.
# The redirect must match the OAuth client exactly.
#   https://$SITE_DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Comma-separated exact emails. No domain matching: nobody else may sign in.
GOOGLE_ALLOWED_EMAILS=

# ---- The model -------------------------------------------------------------------

# `fixture` is deterministic, offline and free. `gemini` calls the real API and
# needs LLM_API_KEY. Investigations are rate limited to 10/min either way, which
# is what stops a free-tier key being exhausted by accident.
LLM_PROVIDER=fixture
LLM_API_KEY=

# ---- Not set here, on purpose -----------------------------------------------------

# APP_ENV, TRUST_PROXY_HOPS, SESSION_COOKIE_SECURE, DEMO_ENABLED, DATABASE_URL,
# REDIS_URL, CORS_ORIGIN and API_INTERNAL_URL are set by docker-compose.prod.yml.
# Overriding them here would let a deploy contradict its own production checks:
# APP_ENV=production refuses to start unless the cookie is Secure, a proxy hop
# count is given, and demo routes are off.