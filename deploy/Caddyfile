# Reverse proxy and TLS. The only service that publishes a port to the internet;
# everything else is reachable from the compose network alone.
#
# SITE_DOMAIN is supplied by compose from .env.production, so there is exactly
# one place the hostname is written down.

{
	# Real client addresses for the rate limit and the audit trail. Fastify is
	# configured with TRUST_PROXY_HOPS=1 to match this one hop.
	trusted_proxies static private_ranges
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# The live dashboard is Server-Sent Events: one long-lived response. Proxy
	# buffering would hold events back until the buffer filled, which for a
	# stream that sends one event at a time means never.
	@stream path /api/events/stream
	handle @stream {
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	# Everything else: the browser reaches only the web server, which holds the
	# session cookie and talks to the API over the private network.
	handle {
		reverse_proxy web:3000
	}

	header {
		# The API serves JSON only; nothing here should ever be framed or sniffed.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Removed by Caddy: the app sets its own, and this one would block APIs.
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		# Requests only, no bodies: a body could carry an operator's password.
		output stdout
		format console
	}
}