{
  "name": "labops-copilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,yellow,green \"npm run dev -w @labops/api\" \"npm run dev:worker -w @labops/api\" \"npm run dev -w @labops/web\"",
    "dev:api": "npm run dev -w @labops/api",
    "dev:web": "npm run dev -w @labops/web",
    "dev:worker": "npm run dev:worker -w @labops/api",
    "db:up": "docker compose up -d postgres redis",
    "db:generate": "npm run prisma:generate -w @labops/api",
    "db:migrate": "npm run prisma:migrate -w @labops/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.71.2"
  }
}
