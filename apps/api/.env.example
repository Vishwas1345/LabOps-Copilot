DATABASE_URL="postgresql://labops:labops@localhost:5432/labops"
# Integration tests only; must differ from DATABASE_URL. Created and migrated
# automatically on each run.
TEST_DATABASE_URL="postgresql://labops:labops@localhost:5432/labops_test"
# Use your compose REDIS_HOST_PORT if you changed it (see docs/infra/INFRA.md).
REDIS_URL=redis://localhost:6379
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Local http only: the session cookie is Secure (https-only) unless this is false.
SESSION_COOKIE_SECURE=false
# `npm run seed:operator` creates or resets this operator. Choose a password of
# at least 12 characters; leaving it empty seeds nobody.
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=
# Local and demo only. Leave unset (false) anywhere else.
DEMO_ENABLED=true
