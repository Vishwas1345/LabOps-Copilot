DATABASE_URL="postgresql://labops:labops@localhost:5432/labops"
# Integration tests only; must differ from DATABASE_URL. Created and migrated
# automatically on each run.
TEST_DATABASE_URL="postgresql://labops:labops@localhost:5432/labops_test"
# Use your compose REDIS_HOST_PORT if you changed it (see docs/infra/INFRA.md).
REDIS_URL=redis://localhost:6379
API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
# Local http only: the session cookie is Secure (https-only) unless this is false.
SESSION_COOKIE_SECURE=false
# `npm run seed:operator` creates or resets this operator. Choose a password of
# at least 12 characters; leaving it empty seeds nobody.
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=
# Local and demo only. Leave unset (false) anywhere else.
DEMO_ENABLED=true
# Model provider. `fixture` is deterministic and offline; `gemini` calls the
# real API and requires LLM_API_KEY. Never set a real provider anywhere but a
# local or demo environment.
LLM_PROVIDER=fixture
# Required only when LLM_PROVIDER=gemini. Never logged, never returned, never
# stored in the database.
LLM_API_KEY=
# Default is gemini-3.1-flash-lite, chosen because it was the only model a free
# tier key could reach when this was written. Verify before relying on it.
LLM_MODEL=gemini-3.1-flash-lite
# Must be https, or http on a loopback host: the key rides in a request header.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Bounded attempts against 429/503. The free tier throttles hard under load.
LLM_MAX_ATTEMPTS=3
