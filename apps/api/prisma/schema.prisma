generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors LAB_STATUSES in src/labs/transitions.ts. The enum makes an illegal
// status unrepresentable; the transition map decides which moves are legal.
enum LabStatus {
  provisioning
  ready
  failed
  recovering
  stopped
}

enum LabSource {
  simulated
  provider
}

enum DependencyStatus {
  healthy
  degraded
  down
}

// Mirrors ERROR_CATEGORIES in src/labs/failures.ts.
enum ErrorCategory {
  PROVISION_TIMEOUT
  NETWORK_CONFIG
  PERMISSION_DENIED
  DEPENDENCY_UNAVAILABLE
  QUOTA_EXCEEDED
  VALIDATION_FAILED
}

enum EventType {
  provision_succeeded
  provision_failed
}

enum JobStatus {
  queued
  running
  succeeded
  failed
}

// Mirrors INCIDENT_STATUSES in src/incidents/transitions.ts.
enum IncidentStatus {
  open
  investigating
  awaiting_approval
  recovering
  resolved
  manual_review
}

enum Severity {
  low
  medium
  high
}

enum ActorType {
  human
  system
  worker
  ai
}

model Lab {
  id           String             @id @default(cuid())
  name         String
  // Free text until the simulator defines real types (Phase 2).
  labType      String             @default("standard")
  // Starts where the lifecycle state machine starts.
  status       LabStatus          @default(provisioning)
  // Every lab is simulated today; a provider-fed lab must say so explicitly.
  source       LabSource          @default(simulated)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  dependencies LabDependency[]
  events       OperationalEvent[]
  incidents    IncidentLab[]

  // Serves the paginated list: newest first, id as the tie-breaker.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// A shared resource several labs rely on (an image registry, a network).
// Two labs failing on one dependency is the strongest correlation signal.
model Dependency {
  id     String             @id @default(cuid())
  kind   String
  status DependencyStatus   @default(healthy)
  labs   LabDependency[]
  events OperationalEvent[]
}

model LabDependency {
  labId        String
  dependencyId String
  lab          Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)
  dependency   Dependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)

  @@id([labId, dependencyId])
  @@index([dependencyId])
}

// Append-only: a database trigger (see the migration) rejects UPDATE, DELETE
// and TRUNCATE, so history cannot be rewritten by any code path.
model AuditEntry {
  id            String    @id @default(cuid())
  // Insertion order across processes, for display and paging. Not commit
  // order: two transactions can commit in the opposite order to their seqs.
  seq           BigInt    @unique @default(autoincrement())
  actorType     ActorType
  actorId       String
  action        String
  targetType    String
  targetId      String
  outcome       String
  correlationId String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  // The writing transaction's id, set by the database. Live updates read
  // only rows older than the oldest running transaction, so nothing is
  // delivered before it commits and nothing is skipped (Phase 10).
  txid          Unsupported("xid8") @default(dbgenerated("pg_current_xact_id()"))

  @@index([targetType, targetId, seq])
  @@index([txid])
}

// Stored redacted. A CHECK in the migration requires an errorCategory on
// failures and forbids one on successes.
model OperationalEvent {
  id                String         @id @default(cuid())
  labId             String
  lab               Lab            @relation(fields: [labId], references: [id], onDelete: Cascade)
  type              EventType
  errorCategory     ErrorCategory?
  dependencyId      String?
  dependency        Dependency?    @relation(fields: [dependencyId], references: [id], onDelete: SetNull)
  message           String
  metadata          Json?
  source            LabSource
  occurredAt        DateTime
  receivedAt        DateTime       @default(now())
  // One row per logical event: a redelivery hits this and is not stored twice.
  deduplicationKey  String         @unique
  anchoredIncidents Incident[]
  incidentLabs      IncidentLab[]

  // Correlation reads by lab, by category and by dependency, each over time.
  @@index([labId, occurredAt])
  @@index([errorCategory, occurredAt])
  @@index([dependencyId, occurredAt])
}

// Postgres mirror of queue state: Redis is transport, this is the record.
// Written in the same transaction as the work that needs it (outbox), so a
// job is never lost if Redis is down at enqueue time.
model JobExecution {
  id           String    @id @default(cuid())
  queue        String
  // Idempotency key; also the BullMQ job id, so duplicate enqueues collapse.
  jobKey       String    @unique
  payload      Json
  status       JobStatus @default(queued)
  // Bumped on every re-enqueue, so a finishing run can tell it is stale.
  generation   Int       @default(1)
  attempts     Int       @default(0)
  errorSummary String?
  traceparent  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  // The reconciler scans for stale queued and running rows.
  @@index([status, updatedAt])
}

// A candidate incident: failures grouped by deterministic scoring, never by
// the LLM. A partial unique index (migration) allows one open incident per
// windowKey, so concurrent or repeated correlation cannot duplicate it.
model Incident {
  id                String           @id @default(cuid())
  title             String
  status            IncidentStatus   @default(open)
  severity          Severity
  windowKey         String
  anchorEventId     String
  anchorEvent       OperationalEvent @relation(fields: [anchorEventId], references: [id])
  // Correlation strength, not certainty; null for a single-lab incident.
  confidenceScore   Float?
  correlationReason Json
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  resolvedAt        DateTime?
  labs              IncidentLab[]
  investigations    Investigation[]
  recoveryActions   RecoveryAction[]

  @@index([status, createdAt(sort: Desc)])
  // Correlation finds open incidents by the failures it loaded.
  @@index([anchorEventId])
}

// Why each lab is in an incident: the reason and score the UI shows verbatim.
model IncidentLab {
  incidentId  String
  incident    Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  labId       String
  lab         Lab              @relation(fields: [labId], references: [id], onDelete: Cascade)
  eventId     String
  event       OperationalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reason      String
  // Score against the anchor; null for the anchor itself.
  signalScore Float?
  signals     Json
  createdAt   DateTime         @default(now())

  @@id([incidentId, labId])
  @@index([labId])
  // Correlation skips failures already in an incident on every run.
  @@index([eventId])
}

// A person who can sign in. Usernames are unique; only a scrypt hash of the
// password is stored, and no endpoint ever returns it.
model Operator {
  id           String            @id @default(cuid())
  username     String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     OperatorSession[]
}

// A server-side session. The id is the SHA-256 of the cookie's random token,
// so a database leak hands out no live sessions; revokedAt makes logout real.
model OperatorSession {
  id         String    @id
  operatorId String
  operator   Operator  @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([operatorId])
}

// The only recovery actions that can ever exist (ARCHITECTURE §10). The model
// may recommend one; nothing executes it until policy (Phase 8) and approval.
enum ActionType {
  RETRY_PROVISIONING
  RECHECK_DEPENDENCY
  RERUN_VALIDATION
  ESCALATE_MANUAL
}

enum InvestigationStatus {
  pending
  running
  completed
  error
}

enum InvestigationOutcome {
  diagnosis
  insufficient_evidence
}

enum InvestigationFailure {
  TIMEOUT
  MALFORMED_OUTPUT
  SCHEMA_REJECTED
  // The provider says it stopped at the token ceiling, so the output is half an
  // object. Distinct from MALFORMED_OUTPUT because the cause and the fix differ.
  TRUNCATED_OUTPUT
  REFUSED
  PROVIDER_ERROR
  JOB_EXHAUSTED
}

// One AI analysis of an incident. Everything the model said is stored only
// after strict validation, with targets already cut to the incident's labs.
// A partial unique index (migration) allows one active analysis per incident.
model Investigation {
  id                String                @id @default(cuid())
  incidentId        String
  incident          Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  status            InvestigationStatus   @default(pending)
  requestedBy       String
  outcome           InvestigationOutcome?
  summary           String?
  candidateCause    String?
  evidenceFor       String[]
  evidenceAgainst   String[]
  missingEvidence   String[]
  diagnosticChecks  String[]
  confidence        Float?
  recommendedAction ActionType?
  targetLabIds      String[]
  // What the model named that was not in the incident, kept for transparency.
  droppedTargets    String[]
  // Counts of what the evidence pack included, omitted, truncated and redacted.
  evidenceSummary   Json?
  failure           InvestigationFailure?
  // Provider, model and latency only; never the prompt or a secret.
  modelMetadata     Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  completedAt       DateTime?

  @@index([incidentId, createdAt(sort: Desc)])
}

enum RecoveryActionStatus {
  rejected_by_policy
  awaiting_approval
  approved
  rejected
  expired
  running
  succeeded
  failed
  blocked
}

// A proposed recovery action and every decision made about it. Only the
// allow-listed ActionType can exist; policyDecisions records each policy step
// and its reason, so the operator sees exactly which rule allowed or blocked it.
model RecoveryAction {
  id                 String               @id @default(cuid())
  incidentId         String
  incident           Incident             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  // The investigation that recommended it; null when an operator proposed it.
  investigationId    String?
  actionType         ActionType
  targetIds          String[]
  parameters         Json
  status             RecoveryActionStatus
  // incident:action:targets-hash:attempt. Unique, so one logical action is
  // proposed and executed once however many times it is requested.
  idempotencyKey     String               @unique
  proposedBy         String
  policyDecisions    Json
  blockedAt          String?
  approvedBy         String?
  approvedAt         DateTime?
  expiresAt          DateTime?
  executedAt         DateTime?
  result             Json?
  verificationResult Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([incidentId, createdAt(sort: Desc)])
  // Rate limits and concurrency look up recent actions by target.
  @@index([targetIds], type: Gin)
  // The expiry sweep finds awaiting_approval rows past their deadline.
  @@index([status, expiresAt])
}
