generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mirrors LAB_STATUSES in src/labs/transitions.ts. The enum makes an illegal
// status unrepresentable; the transition map decides which moves are legal.
enum LabStatus {
  provisioning
  ready
  failed
  recovering
  stopped
}

enum LabSource {
  simulated
  provider
}

enum DependencyStatus {
  healthy
  degraded
  down
}

// Mirrors ERROR_CATEGORIES in src/labs/failures.ts.
enum ErrorCategory {
  PROVISION_TIMEOUT
  NETWORK_CONFIG
  PERMISSION_DENIED
  DEPENDENCY_UNAVAILABLE
  QUOTA_EXCEEDED
  VALIDATION_FAILED
}

enum EventType {
  provision_succeeded
  provision_failed
}

enum JobStatus {
  queued
  running
  succeeded
  failed
}

enum ActorType {
  human
  system
  worker
  ai
}

model Lab {
  id           String          @id @default(cuid())
  name         String
  // Free text until the simulator defines real types (Phase 2).
  labType      String          @default("standard")
  // Starts where the lifecycle state machine starts.
  status       LabStatus       @default(provisioning)
  // Every lab is simulated today; a provider-fed lab must say so explicitly.
  source       LabSource       @default(simulated)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  dependencies LabDependency[]
  events       OperationalEvent[]

  // Serves the paginated list: newest first, id as the tie-breaker.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}

// A shared resource several labs rely on (an image registry, a network).
// Two labs failing on one dependency is the strongest correlation signal.
model Dependency {
  id     String           @id @default(cuid())
  kind   String
  status DependencyStatus @default(healthy)
  labs   LabDependency[]
  events OperationalEvent[]
}

model LabDependency {
  labId        String
  dependencyId String
  lab          Lab        @relation(fields: [labId], references: [id], onDelete: Cascade)
  dependency   Dependency @relation(fields: [dependencyId], references: [id], onDelete: Cascade)

  @@id([labId, dependencyId])
  @@index([dependencyId])
}

// Append-only: a database trigger (see the migration) rejects UPDATE, DELETE
// and TRUNCATE, so history cannot be rewritten by any code path.
model AuditEntry {
  id            String    @id @default(cuid())
  // Total order across processes; live updates resume from it (Phase 10).
  seq           BigInt    @unique @default(autoincrement())
  actorType     ActorType
  actorId       String
  action        String
  targetType    String
  targetId      String
  outcome       String
  correlationId String?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([targetType, targetId, seq])
}

// Stored redacted. A CHECK in the migration requires an errorCategory on
// failures and forbids one on successes.
model OperationalEvent {
  id               String         @id @default(cuid())
  labId            String
  lab              Lab            @relation(fields: [labId], references: [id], onDelete: Cascade)
  type             EventType
  errorCategory    ErrorCategory?
  dependencyId     String?
  dependency       Dependency?    @relation(fields: [dependencyId], references: [id], onDelete: SetNull)
  message          String
  metadata         Json?
  source           LabSource
  occurredAt       DateTime
  receivedAt       DateTime       @default(now())
  // One row per logical event: a redelivery hits this and is not stored twice.
  deduplicationKey String         @unique

  // Correlation reads by lab, by category and by dependency, each over time.
  @@index([labId, occurredAt])
  @@index([errorCategory, occurredAt])
  @@index([dependencyId, occurredAt])
}

// Postgres mirror of queue state: Redis is transport, this is the record.
// Written in the same transaction as the work that needs it (outbox), so a
// job is never lost if Redis is down at enqueue time.
model JobExecution {
  id           String    @id @default(cuid())
  queue        String
  // Idempotency key; also the BullMQ job id, so duplicate enqueues collapse.
  jobKey       String    @unique
  payload      Json
  status       JobStatus @default(queued)
  // Bumped on every re-enqueue, so a finishing run can tell it is stale.
  generation   Int       @default(1)
  attempts     Int       @default(0)
  errorSummary String?
  traceparent  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  // The reconciler scans for stale queued and running rows.
  @@index([status, updatedAt])
}
